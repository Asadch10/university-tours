# Never ship local state or secrets into an image.
node_modules
**/node_modules
**/.next
**/dist
**/.turbo
.git
.env
**/.env
**/.env.*
!**/.env.example
# User uploads live in a named volume, not the image.
apps/backend/uploads
# Native projects are regenerated by expo prebuild.
apps/mobile/ios
apps/mobile/android
**/*.log
.DS_Store
