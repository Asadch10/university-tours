// University Campus Private Tours — PostgreSQL logical model (Part IV).
// PostgreSQL is the system of record; money is integer cents, timestamps are UTC,
// financial history is immutable (commission snapshot + append-only ledger).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// Single-admin mode: one admin role with full access. MANAGER and SUPPORT were
// removed — the console never enforced them, so an account carrying one of those
// labels still had every power, which made the label actively misleading.
enum AdminRoleName {
  SUPER_ADMIN
}

enum ServiceType {
  CAMPUS_TOUR
  VIDEO_CONSULTATION
  CONSULTATION
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SUSPENDED
}

enum ApplicationStatus {
  NOT_SUBMITTED
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

// Which marketplace side someone is applying to join. Guides are enrolled students
// verified against a school; counselors are outside admissions professionals with no
// enrollment. Both are UserRole.SELLER — this is what tells the two flows apart.
enum ApplicantKind {
  GUIDE
  COUNSELOR
}

// How an applicant's identity/enrolment was checked.
//
// These are NOT equivalent: STRIPE_IDENTITY proves a government ID is genuine and
// matches a selfie — it says nothing about enrolment. Only IDME can confirm someone is
// actually a student. MANUAL is an admin reading the uploaded document, and remains the
// fallback for anyone automated checks cannot handle (international students especially).
enum VerificationMethod {
  MANUAL
  STRIPE_IDENTITY
  IDME
}

enum VerificationStatus {
  PENDING // session created, applicant has not finished
  PROCESSING // submitted, provider still checking
  VERIFIED
  FAILED // provider rejected, or admin declined
  CANCELED
}

enum BookingStatus {
  PENDING_PAYMENT // card not yet authorized — hidden from the guide until the hold clears
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum LedgerEntryType {
  CAPTURE
  REFUND
}

enum QuestionnaireStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum QuestionType {
  TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  FILE
}

enum DocumentAccessLevel {
  ADMIN_ONLY
  PRIVATE
  PUBLIC
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum CampaignSegment {
  ALL
  BUYERS
  GUIDES
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

enum DevicePlatform {
  IOS
  ANDROID
}

// ----------------------------------------------------------------------------
// Identity
// ----------------------------------------------------------------------------

model User {
  id                   String         @id @default(cuid())
  role                 UserRole? // null until decided by onboarding (BUYER = book tours, SELLER = guide)
  email                String         @unique
  name                 String         @default("")
  passwordHash         String         @map("password_hash")
  status               UserStatus     @default(ACTIVE)
  emailVerifiedAt      DateTime?      @map("email_verified_at")
  adminRoleName        AdminRoleName? @map("admin_role_name")
  profileJson          Json?          @map("profile_json") // website profile fields (all optional)
  // Stripe Connect (Express) — a guide's connected account for receiving payouts.
  stripeAccountId      String?        @map("stripe_account_id")
  stripePayoutsEnabled Boolean        @default(false) @map("stripe_payouts_enabled")
  // Stripe Customer — for saving the user's cards on file (guest payments).
  stripeCustomerId     String?        @map("stripe_customer_id")
  createdAt            DateTime       @default(now()) @map("created_at")

  sellerProfile    SellerProfile?
  counselorProfile CounselorProfile?
  verifications    IdentityVerification[]
  devices          Device[]
  listings         Listing[]              @relation("SellerListings")
  buyerBookings    Booking[]              @relation("BuyerBookings")
  sellerBookings   Booking[]              @relation("SellerBookings")
  buyerConvos      Conversation[]         @relation("BuyerConversations")
  sellerConvos     Conversation[]         @relation("SellerConversations")
  messages         Message[]
  buyerReviews     Review[]               @relation("BuyerReviews")
  sellerReviews    Review[]               @relation("SellerReviews")
  documents        Document[]
  applications     Application[]
  payouts          Payout[]
  refundsCreated   Refund[]
  auditLogs        AuditLog[]

  @@index([role, status])
  @@map("users")
}

model SellerProfile {
  userId            String            @id @map("user_id")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo             String?
  phone             String?
  dob               DateTime?
  schoolId          String?           @map("school_id")
  school            School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  major             String?
  gradYear          Int?              @map("grad_year")
  bio               String?           @db.Text
  enrollmentDocId   String?           @unique @map("enrollment_doc_id")
  enrollmentDoc     Document?         @relation("EnrollmentDoc", fields: [enrollmentDocId], references: [id], onDelete: SetNull)
  applicationStatus ApplicationStatus @default(NOT_SUBMITTED) @map("application_status")
  approvedAt        DateTime?         @map("approved_at")
  ratingAvg         Float             @default(0) @map("rating_avg")
  ratingCount       Int               @default(0) @map("rating_count")

  @@index([schoolId])
  @@map("seller_profiles")
}

// A college counselor — an outside admissions professional, not an enrolled student.
// Deliberately a sibling of SellerProfile rather than a `kind` column on it: the two
// verify differently (enrollment doc vs. professional credential) and share almost no
// fields, and keeping them separate lets one user hold both roles at once, each with
// its own independent approval status.
model CounselorProfile {
  userId            String            @id @map("user_id")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo             String?
  phone             String?
  // Professional identity.
  headline          String? // e.g. "Independent college admissions counselor"
  organization      String? // firm or practice name; null for solo counselors
  website           String?
  yearsExperience   Int?              @map("years_experience")
  credentials       String? // e.g. "M.Ed., IECA Professional Member"
  specialtiesJson   Json?             @map("specialties_json") // string[] — e.g. ["Essays", "Financial aid"]
  bio               String?           @db.Text
  // Proof of credential, reviewed by admin — the counselor equivalent of a guide's
  // enrollment document.
  credentialDocId   String?           @unique @map("credential_doc_id")
  credentialDoc     Document?         @relation("CredentialDoc", fields: [credentialDocId], references: [id], onDelete: SetNull)
  applicationStatus ApplicationStatus @default(NOT_SUBMITTED) @map("application_status")
  approvedAt        DateTime?         @map("approved_at")
  ratingAvg         Float             @default(0) @map("rating_avg")
  ratingCount       Int               @default(0) @map("rating_count")

  @@map("counselor_profiles")
}

/// An identity/enrolment check for one applicant, by one provider.
///
/// Deliberately its own table rather than columns on SellerProfile/CounselorProfile:
/// a user may hold both roles, each needing its own check, and a provider-agnostic row
/// means adding ID.me later is a new `method` value rather than a schema migration.
model IdentityVerification {
  id         String             @id @default(cuid())
  userId     String             @map("user_id")
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which application this check backs — a user can need one per role.
  kind       ApplicantKind      @default(GUIDE)
  method     VerificationMethod
  status     VerificationStatus @default(PENDING)
  /// Provider's own id (Stripe VerificationSession id, ID.me subject). Unique so a
  /// webhook can find the row without trusting anything in its payload.
  sessionId  String?            @unique @map("session_id")
  /// Why the provider rejected it, or the admin's note on a manual decision.
  lastError  String?            @map("last_error") @db.Text
  /// Redacted provider outcome. NEVER the document images or raw ID numbers.
  reportJson Json?              @map("report_json")
  /// Admin who made a MANUAL decision; null for automated outcomes.
  decidedBy  String?            @map("decided_by")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  verifiedAt DateTime?          @map("verified_at")

  @@unique([userId, kind])
  @@index([status])
  @@map("identity_verifications")
}

model Device {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  DevicePlatform
  pushToken String         @unique @map("push_token") // Expo push token (unique so a device re-registers, not duplicates)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@map("devices")
}

model AdminRole {
  role            AdminRoleName @id
  permissionsJson Json          @map("permissions_json")

  @@map("admin_roles")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     String
  entity     String
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([entity])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model School {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique // auto-generated from name; drives /universities/{slug}
  image          String? // campus photo (banner + card + logo)
  location       String? // e.g. "Stanford, CA"
  state          String? // e.g. "California"
  tags           Json?   @db.Json // popular programs, e.g. ["Engineering", "Business"] (null = none)
  toursFromCents Int?    @map("tours_from_cents") // starting tour price, integer cents
  seoContent     String? @map("seo_content") @db.Text
  lat            Float? // campus coordinates — drive the pin on the website's explore map
  lng            Float?
  enabled        Boolean @default(true)

  sellerProfiles SellerProfile[]
  listings       Listing[]

  @@index([name])
  @@map("schools")
}

model Listing {
  id          String        @id @default(cuid())
  sellerId    String        @map("seller_id")
  seller      User          @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Restrict)
  // Which marketplace this listing belongs to. Not derivable from the seller: one user
  // may be an approved guide AND an approved counselor, so without this the two browse
  // pages could not tell their listings apart.
  kind        ApplicantKind @default(GUIDE)
  // Optional: guide listings are always campus-bound, but a counselor is an outside
  // professional with no home campus, so their listing has no school.
  schoolId    String?       @map("school_id")
  school      School?       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  serviceType ServiceType   @map("service_type")
  title       String
  description String?       @db.Text
  status      ListingStatus @default(ACTIVE)

  options  ListingOption[]
  bookings Booking[]

  @@index([schoolId, serviceType, status])
  @@index([kind, status])
  @@index([sellerId])
  @@map("listings")
}

model ListingOption {
  id              String  @id @default(cuid())
  listingId       String  @map("listing_id")
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  durationMinutes Int     @map("duration_minutes")
  priceCents      Int     @map("price_cents")

  bookings Booking[]

  @@index([listingId])
  @@map("listing_options")
}

model ServicePriceBound {
  serviceType      ServiceType @id @map("service_type")
  minCents         Int         @map("min_cents")
  maxCents         Int         @map("max_cents")
  suggested1hCents Int         @map("suggested_1h_cents")
  suggested2hCents Int         @map("suggested_2h_cents")

  @@map("service_price_bounds")
}

// ----------------------------------------------------------------------------
// Booking & money
// ----------------------------------------------------------------------------

model Booking {
  id                    String         @id @default(cuid())
  // Human-friendly sequential reference shown to users as "B-1", "B-2", … while the
  // cuid `id` stays the internal/routing key.
  bookingNo             Int            @unique @default(autoincrement()) @map("booking_no")
  buyerId               String         @map("buyer_id")
  buyer                 User           @relation("BuyerBookings", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId              String         @map("seller_id")
  seller                User           @relation("SellerBookings", fields: [sellerId], references: [id], onDelete: Restrict)
  // Which marketplace this booking came from. Stamped at creation and never derived:
  // one user can be both a guide and a counselor, and `serviceType` can't tell them
  // apart either (a guide may also sell "Professional consultation"). This is what
  // splits My bookings into "As guide" and "As counselor".
  kind                  ApplicantKind  @default(GUIDE)
  // Nullable: website "become a guide" listings live in User.profileJson, not the
  // Listing table, so a guide booking has no Listing/Option row — the snapshot
  // fields below (listingTitle, durationMinutes, grossCents…) carry what was booked.
  listingId             String?        @map("listing_id")
  listing               Listing?       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  optionId              String?        @map("option_id")
  option                ListingOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)
  listingTitle          String?        @map("listing_title") @db.Text // snapshot of what was booked
  durationMinutes       Int?           @map("duration_minutes")
  serviceType           ServiceType    @map("service_type")
  schoolId              String?        @map("school_id")
  schoolName            String?        @map("school_name") // snapshot (guides have no Listing→School link)
  scheduledDate         DateTime       @map("scheduled_date")
  scheduledTime         String?        @map("scheduled_time")
  guestCount            Int            @default(1) @map("guest_count")
  noteForGuide          String?        @map("note_for_guide") @db.Text
  status                BookingStatus  @default(PENDING)
  stripePaymentIntentId String?        @map("stripe_payment_intent_id")
  grossCents            Int            @map("gross_cents")
  commissionPctSnapshot Float?         @map("commission_pct_snapshot")
  commissionCents       Int?           @map("commission_cents")
  sellerNetCents        Int?           @map("seller_net_cents")
  videoLink             String?        @map("video_link")
  requestedAt           DateTime       @default(now()) @map("requested_at")
  expiresAt             DateTime?      @map("expires_at")
  confirmedAt           DateTime?      @map("confirmed_at")
  completedAt           DateTime?      @map("completed_at")
  reviewedAt            DateTime?      @map("reviewed_at")

  events  BookingEvent[]
  ledger  LedgerEntry[]
  refunds Refund[]
  review  Review?
  convo   Conversation?
  payment Payment?

  @@index([sellerId, status])
  @@index([sellerId, kind, status])
  @@index([buyerId, status])
  @@index([scheduledDate])
  @@index([status, expiresAt])
  @@map("bookings")
}

model BookingEvent {
  id        String         @id @default(cuid())
  bookingId String         @map("booking_id")
  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromState BookingStatus? @map("from_state")
  toState   BookingStatus  @map("to_state")
  actor     String
  reason    String?        @db.Text
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("booking_events")
}

model LedgerEntry {
  id              String          @id @default(cuid())
  bookingId       String          @map("booking_id")
  booking         Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  type            LedgerEntryType
  grossCents      Int             @map("gross_cents")
  commissionPct   Float           @map("commission_pct")
  commissionCents Int             @map("commission_cents")
  sellerNetCents  Int             @map("seller_net_cents")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("ledger_entries")
}

model Payout {
  id             String   @id @default(cuid())
  sellerId       String   @map("seller_id")
  seller         User     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  amountCents    Int      @map("amount_cents")
  method         String
  reference      String?
  note           String?  @db.Text
  createdByAdmin String   @map("created_by_admin")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([sellerId])
  @@map("payouts")
}

model Refund {
  id             String   @id @default(cuid())
  bookingId      String   @map("booking_id")
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amountCents    Int      @map("amount_cents")
  stripeRefundId String?  @map("stripe_refund_id")
  reason         String?  @db.Text
  createdBy      String   @map("created_by")
  createdByUser  User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([bookingId])
  @@map("refunds")
}

// Stripe payment record — one per booking. Captures the full PaymentIntent payload
// (rawJson) plus the extracted fields the admin invoice view needs. Written when the
// card is authorized, updated on capture / refund.
model Payment {
  id                    String    @id @default(cuid())
  bookingId             String    @unique @map("booking_id")
  booking               Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String    @map("stripe_payment_intent_id")
  stripeChargeId        String?   @map("stripe_charge_id")
  amountCents           Int       @map("amount_cents")
  amountRefundedCents   Int       @default(0) @map("amount_refunded_cents")
  currency              String    @default("usd")
  status                String // requires_capture | succeeded | canceled | refunded | partially_refunded
  cardBrand             String?   @map("card_brand")
  cardLast4             String?   @map("card_last4")
  cardExpMonth          Int?      @map("card_exp_month")
  cardExpYear           Int?      @map("card_exp_year")
  billingName           String?   @map("billing_name")
  billingEmail          String?   @map("billing_email")
  receiptUrl            String?   @map("receipt_url") @db.Text
  rawJson               Json      @map("raw_json") // full Stripe PaymentIntent payload
  authorizedAt          DateTime? @map("authorized_at")
  capturedAt            DateTime? @map("captured_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([stripePaymentIntentId])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// Onboarding
// ----------------------------------------------------------------------------

model Questionnaire {
  id      String              @id @default(cuid())
  // Which application flow this questionnaire drives. Guides and counselors are
  // managed independently in admin, so versions are numbered PER KIND — hence the
  // composite unique below rather than a bare `@unique` on version.
  kind    ApplicantKind       @default(GUIDE)
  version Int
  status  QuestionnaireStatus @default(DRAFT)

  questions    QuestionnaireQuestion[]
  applications Application[]

  @@unique([kind, version])
  @@map("questionnaires")
}

model QuestionnaireQuestion {
  id              String        @id @default(cuid())
  questionnaireId String        @map("questionnaire_id")
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  type            QuestionType
  label           String
  required        Boolean       @default(false)
  order           Int
  optionsJson     Json?         @map("options_json")
  // Stable storage key so answers save under the same listing field the guide
  // profile / search read (e.g. "gender", "hometown"). Null = store under id.
  fieldKey        String?       @map("field_key")

  @@index([questionnaireId])
  @@map("questionnaire_questions")
}

model Application {
  id                     String            @id @default(cuid())
  sellerId               String            @map("seller_id")
  seller                 User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  // GUIDE or COUNSELOR. A user may hold one of each, so this is what separates
  // "my guide application" from "my counselor application" for the same user.
  // Defaults to GUIDE so every pre-existing row keeps its meaning.
  kind                   ApplicantKind     @default(GUIDE)
  questionnaireVersionId String            @map("questionnaire_version_id")
  questionnaire          Questionnaire     @relation(fields: [questionnaireVersionId], references: [id], onDelete: Restrict)
  status                 ApplicationStatus @default(SUBMITTED)
  reason                 String?           @db.Text
  submittedAt            DateTime          @default(now()) @map("submitted_at")

  answers ApplicationAnswer[]

  @@index([sellerId, kind])
  @@index([status])
  @@index([kind])
  @@map("applications")
}

model ApplicationAnswer {
  id                    String      @id @default(cuid())
  applicationId         String      @map("application_id")
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionLabelSnapshot String      @map("question_label_snapshot")
  optionsSnapshot       Json?       @map("options_snapshot")
  value                 String?
  fileId                String?     @map("file_id")
  file                  Document?   @relation("AnswerFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@map("application_answers")
}

// ----------------------------------------------------------------------------
// Engagement
// ----------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  buyerId   String   @map("buyer_id")
  buyer     User     @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String   @map("seller_id")
  seller    User     @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  bookingId String?  @unique @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([buyerId])
  @@index([sellerId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String?      @db.Text
  imageId        String?      @map("image_id")
  image          Document?    @relation("MessageImage", fields: [imageId], references: [id], onDelete: SetNull)
  masked         Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  buyerId   String   @map("buyer_id")
  buyer     User     @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId  String   @map("seller_id")
  seller    User     @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Restrict)
  rating    Int
  text      String?  @db.Text
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sellerId, hidden])
  @@map("reviews")
}

model Document {
  id          String              @id @default(cuid())
  ownerId     String              @map("owner_id")
  owner       User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type        String
  s3Key       String              @map("s3_key")
  accessLevel DocumentAccessLevel @default(ADMIN_ONLY) @map("access_level")
  encrypted   Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at")

  enrollmentFor SellerProfile?      @relation("EnrollmentDoc")
  credentialFor CounselorProfile?   @relation("CredentialDoc")
  answers       ApplicationAnswer[] @relation("AnswerFile")
  messages      Message[]           @relation("MessageImage")

  @@index([ownerId])
  @@map("documents")
}

// ----------------------------------------------------------------------------
// Platform
// ----------------------------------------------------------------------------

model CmsBlock {
  id          String  @id @default(cuid())
  key         String  @unique
  type        String
  contentJson Json    @map("content_json")
  published   Boolean @default(false)

  @@map("cms_blocks")
}

// Messages submitted from the public website "Contact us" form.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String   @db.Text
  status    String   @default("new") // new | read
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

model AppConfig {
  id                        String  @id @default(cuid())
  featureFlagsJson          Json    @map("feature_flags_json")
  minSupportedVersion       String  @map("min_supported_version")
  forceUpdateMessage        String? @map("force_update_message")
  maintenanceBanner         String? @map("maintenance_banner")
  emailNotificationsEnabled Boolean @default(true) @map("email_notifications_enabled") // master switch: off = no emails sent
  pushNotificationsEnabled  Boolean @default(true) @map("push_notifications_enabled") // master switch: off = no mobile push sent

  @@map("app_config")
}

model Settings {
  id                 String  @id @default("singleton")
  commissionPct      Float   @map("commission_pct")
  refundWindowsJson  Json    @map("refund_windows_json")
  requestExpiryHours Int     @map("request_expiry_hours")
  maskingEnabled     Boolean @default(true) @map("masking_enabled")
  // How many profile photos a guide must upload in become-a-guide (admin-set).
  requiredPhotos     Int     @default(3) @map("required_photos")

  @@map("settings")
}

model NotificationTemplate {
  id      String              @id @default(cuid())
  key     String              @unique
  channel NotificationChannel
  subject String?
  body    String              @db.Text

  @@map("notification_templates")
}

model PushCampaign {
  id          String          @id @default(cuid())
  segment     CampaignSegment
  title       String
  body        String          @db.Text
  scheduledAt DateTime?       @map("scheduled_at")
  status      CampaignStatus  @default(DRAFT)

  @@map("push_campaigns")
}

model WebhookEvent {
  stripeEventId String   @id @map("stripe_event_id")
  type          String
  processedAt   DateTime @default(now()) @map("processed_at")

  @@map("webhook_events")
}
