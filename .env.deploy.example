# Deployment settings for docker-compose (copy to .env.deploy on the server).
# .env.deploy is gitignored — it holds secrets.

# ── Traefik wiring ───────────────────────────────────────────────────────────
# Find the real values on the server (see DEPLOY.md step 2):
#   docker inspect $(docker ps -qf name=traefik) --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
TRAEFIK_NETWORK=
# Traefik's Let's Encrypt resolver name, from its static config. Often "letsencrypt".
CERT_RESOLVER=letsencrypt

# ── Domains (DNS A records must point at 2.25.194.37 first) ───────────────────
WEB_DOMAIN=yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
API_DOMAIN=api.yourdomain.com

# ── Database (used by the db container) ───────────────────────────────────────
MYSQL_DATABASE=university_tours
MYSQL_USER=ucpt
MYSQL_PASSWORD=CHANGE_ME_STRONG
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_TOO

# ── Baked into the website bundle at build time ───────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
