# Deployment settings for docker-compose (copy to .env.deploy on the server).
# .env.deploy is gitignored — it holds secrets.

# Traefik needs no configuration here: it runs in host network mode on this VPS and
# discovers containers via the labels in docker-compose.yml. The entrypoint
# (`websecure`) and cert resolver (`letsencrypt`) are hardcoded there, matching the
# working vanuat stack.

# ── Domain (one A record, pointing at 2.25.194.37) ────────────────────────────
# A SINGLE domain serves everything, split by path:
#   /            website
#   /admin       admin console  (the admin app is built with basePath: '/admin')
#   /api, /uploads   backend
# So only one record and one certificate are needed.
WEB_DOMAIN=yourdomain.com

# ── Database (used by the db container) ───────────────────────────────────────
MYSQL_DATABASE=university_tours
MYSQL_USER=ucpt
MYSQL_PASSWORD=CHANGE_ME_STRONG
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_TOO

# ── Baked into the website bundle at build time ───────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
