# Backend runtime environment (copy to .env.backend on the server; gitignored).
NODE_ENV=production
API_PORT=4000

# `db` is the compose service name — resolved on the internal network.
# The password must match MYSQL_PASSWORD in .env.deploy.
DATABASE_URL="mysql://ucpt:CHANGE_ME_STRONG@db:3306/university_tours"

APP_WEB_URL=https://yourdomain.com
# Admin lives under /admin on the same origin.
APP_ADMIN_URL=https://yourdomain.com/admin
# Same-origin now, so a single entry covers website and admin.
CORS_ALLOWLIST=https://yourdomain.com,https://www.yourdomain.com

# Generate fresh secrets — do NOT reuse the Cloudways ones:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMAIL_VERIFY_SECRET=
PASSWORD_RESET_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Re-create the webhook for the new api domain — the old secret will not verify.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Campus Private Tours
MAIL_FROM_ADDRESS=

EXPO_ACCESS_TOKEN=
