# Copy this file to `.env` and adjust as needed.
#
# Base URL of the backend API (WITHOUT the /api/v1 suffix — the client adds it).
# On a physical device the app auto-swaps `localhost` for your Mac's LAN IP, so
# this same value works on the simulator and on a real device in Expo Go.
#
# Local dev (default):
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
#
# Live backend — set to the deployed domain instead, e.g.:
# EXPO_PUBLIC_API_BASE_URL=https://your-live-domain.com
