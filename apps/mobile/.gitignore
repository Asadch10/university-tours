# Native projects are generated by `expo prebuild` (Continuous Native Generation) from
# app.json, so they are build output rather than source. `ios/Pods` alone is ~933 MB and
# contains individual framework binaries over GitHub's 100 MB file limit, which would make
# the push fail outright. Regenerate with `npx expo prebuild` / `pod install`.
/ios/
/android/

# Expo / Metro
.expo/
dist/
web-build/

# Dependencies
node_modules/

# Native build artefacts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# macOS
.DS_Store
